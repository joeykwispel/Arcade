<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The page: Blazor WebAssembly runs the C# game (Pinball.Core); wwwroot/pinball.js draws it on a canvas. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- no fingerprint placeholders: they need an inline import map, which the page's CSP doesn't allow -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- GitHub Pages compresses on its own and doesn't serve .br files -->
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pinball.Core\Pinball.Core.csproj" />
  </ItemGroup>

</Project>
