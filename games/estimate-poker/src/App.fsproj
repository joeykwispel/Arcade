<Project Sdk="Microsoft.NET.Sdk">

  <!-- The page, for Fable: the rules (Poker.fs) and the DOM code (Main.fs), compiled to JavaScript into build/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Poker.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.3.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
  </ItemGroup>

</Project>
