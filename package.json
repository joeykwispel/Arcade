{
  "name": "play",
  "version": "1.0.0",
  "description": "Play: a hub of small browser games at arcade.joeyoosenbrug.nl, each game built with a different frontend stack.",
  "author": "Joey Oosenbrug (https://github.com/joeykwispel)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeykwispel/arcade.git"
  },
  "homepage": "https://arcade.joeyoosenbrug.nl",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build.mjs",
    "build:hub": "vite build",
    "build:games": "node scripts/build.mjs --games-only",
    "preview": "node scripts/serve.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:games": "node scripts/test-games.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@joeykwispel/design-kit": "^1.0.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
